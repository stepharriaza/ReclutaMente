# Copia este archivo a .env y rellena los valores.
# .env está en .gitignore, nunca lo subas al repositorio.

# Motor de base de datos: postgresql (por defecto) o sqlite
DB_ENGINE=sqlite

# Base de datos PostgreSQL
DB_NAME=reclutamente
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# IA (Google Gemini)
GEMINI_API_KEY=

# Correo (si se define EMAIL_HOST se usa SMTP; si no, se imprime en consola)
DEFAULT_FROM_EMAIL=ReclutaMente <no-responder@reclutamente.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Vigencia del enlace de recuperación de contraseña (segundos)
PASSWORD_RESET_TIMEOUT=3600
