# Copia este archivo a .env y rellena los valores.
# .env está en .gitignore, nunca lo subas al repositorio.

# Motor de base de datos: postgresql (por defecto) o sqlite
DB_ENGINE=sqlite

# Base de datos PostgreSQL
DB_NAME=reclutamente
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# IA (Google Gemini)
GEMINI_API_KEY=
# Modelo principal de Gemini (opcional, por defecto gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Duración máxima de cada prueba en minutos (opcional, por defecto 10)
# DURACION_PRUEBA_MINUTOS=10

# Correo (con EMAIL_HOST se usa SMTP; sin servidor, los mensajes se imprimen en consola)
DEFAULT_FROM_EMAIL=ReclutaMente <no-responder@reclutamente.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Solo para desarrollo sin SMTP: permite imprimir los correos en consola.
# En producción NO lo actives o los correos no se enviarán.
# EMAIL_PERMITIR_CONSOLA=True

# Vigencia del enlace de recuperación de contraseña (segundos)
PASSWORD_RESET_TIMEOUT=3600
